

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Email {
  id            String   @id @default(uuid())
  subject       String
  body          String
  recipient     String
  senderId      String
  scheduledAt   DateTime
  sentAt        DateTime?
  status        EmailStatus @default(SCHEDULED)
  errorMessage  String?
  jobId         String?  @unique // BullMQ job ID for idempotency
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([senderId])
}

enum EmailStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

model Sender {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // Ethereal password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails    Email[]
}
